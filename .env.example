# Database
DATABASE_URL=postgresql+psycopg://worldcup:worldcup@postgres:5432/worldcup

# Odds Provider (The Odds API — get a free key at https://the-odds-api.com)
ODDS_API_KEY=replace_me

# Admin password (plain text)
ADMIN_PASSWORD=replace_me

# Session secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace_me

# App
APP_BASE_URL=http://localhost:3000
ENVIRONMENT=development
TIMEZONE=America/Mexico_City

# Exports directory (used inside the container)
EXPORT_DIR=/app/exports

# ── Prediction model V2 (spec WCPO-PRED-MODEL-V2) ────────────────────────────
# Default is v1 so behaviour is unchanged until v2 is validated. Set to "v2" to
# make the market-calibrated full-grid model the default for new model runs.
# v2 can also be selected per-run via the API (parameters.model_version="v2").
# The model registry always falls back v2 -> v1 -> neutral, so enabling v2 can
# never abort a run.
PREDICTION_MODEL_VERSION=v1
V1_FALLBACK_ENABLED=true
ENABLE_RICH_ODDS_REFRESH=false
ENABLE_MARKET_CONSTRAINT_STORAGE=true
ENABLE_BACKTESTING=false
ENABLE_FUNDAMENTAL_PRIOR=true
ENABLE_ASIAN_LINE_SUPPORT=true
# Full actual-outcome grid (0..N) and candidate prediction grid (0..N)
ACTUAL_SCORE_MAX=12
CANDIDATE_SCORE_MAX=5
# De-vig: auto|proportional|power|shin|odds_ratio|exchange_mid
V2_DEVIG_METHOD=auto
V2_DEFAULT_AUTO_DEVIG=power
V2_FALLBACK_DEVIG=proportional
